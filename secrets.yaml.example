# Copy this file to `secrets.yaml` and fill in your own values.
# NEVER commit secrets.yaml - it is in .gitignore.
#
# api_encryption_key: generate your own with
#   openssl rand -base64 32
# (the placeholder below is a valid-format dummy - 32 bytes in base64, which is
# 44 characters ending in "=" - so that `esphome config` validates the YAML
# before you touch anything. Replace it with your own key.)

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="